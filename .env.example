# Environment Variables for AI Cricket Match Predictor
# Copy this file to .env and fill in your values

# Groq API Key (used for LLM insight generation via Groq)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model identifier
LLM_MODEL=openai/gpt-oss-120b

# Django Settings
SECRET_KEY=your-django-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development — change DATABASE_URL to PostgreSQL in production)
# PostgreSQL example: postgresql://user:password@localhost:5432/cricket_db
DATABASE_URL=sqlite:///db.sqlite3
